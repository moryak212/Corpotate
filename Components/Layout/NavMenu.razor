@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Корпоративы</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"></span> Рабочий стол
            </NavLink>
        </div>

        <AuthorizeView Context="auth">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/events">
                        <span class="bi bi-geo-alt-fill-nav-menu"></span> Корпоративы
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/tasks">
                        <span class="bi bi-list-task-nav-menu"></span> Задачи
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/files">
                        <span class="bi bi-file-earmark-fill-nav-menu"></span> Файлы
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/employees">
                                <span class="bi bi-person-badge-fill-nav-menu"></span> Сотрудники
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Organizer" Context="orgAuth">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="venues">
                                <span class="bi-venue-nav-menu" aria-hidden="true"></span>
                                Площадки
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bbq">
                        <span class="bi bi-bbq-calculator-nav-menu" aria-hidden="true"></span>
                        Калькулятор
                    </NavLink>
                </div>


                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/participants">
                        <span class="bi bi-people-fill-nav-menu"></span> Участники
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/auditlogs">
                                <span class="bi-audit-log-nav-menu"></span>
                                Аудит логов
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>





                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logout">
                        <span class="bi bi-logout-nav-menu" aria-hidden="true"></span>
                        Выход
                    </NavLink>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register">Регистрация</NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">Вход</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>