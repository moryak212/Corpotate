@page "/register"
@rendermode InteractiveServer

@using Corporate.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav

<h3>Регистрация</h3>

<EditForm Model="@model" OnValidSubmit="@RegisterAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Пароль</label>
        <InputText class="form-control" @bind-Value="model.Password" type="password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Подтверждение пароля</label>
        <InputText class="form-control" @bind-Value="model.ConfirmPassword" type="password" />
    </div>

    <div class="mb-3">
        <label class="form-label">ФИО</label>
        <InputText class="form-control" @bind-Value="model.FullName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Отдел</label>
        <select class="form-select" @bind="model.Department">
            <option value="">-- выберите отдел --</option>
            @foreach (var d in Departments)
            {
                <option value="@d">@d</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Роль в компании</label>
        <select class="form-select" @bind="model.CompanyRole">
            <option value="">-- выберите роль --</option>
            @foreach (var r in CompanyRoles)
            {
                <option value="@r">@r</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mt-3 text-danger">@errorMessage</div>
}

@code {
    private RegisterModel model = new();
    private string? errorMessage;

    // варианты для выбора (обязательное требование "поля с выбором")
    private readonly string[] Departments = new[]
    {
        "Маркетинг",
        "Продажи",
        "IT",
        "HR",
        "Финансы"
    };

    private readonly string[] CompanyRoles = new[]
    {
        "Сотрудник",
        "Организатор мероприятий",
        "Руководитель отдела"
    };

    private async Task RegisterAsync()
    {
        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Пароль и подтверждение не совпадают.";
            return;
        }

        var user = new AppUser
        {
            UserName = model.Email,
            Email = model.Email,
            FullName = model.FullName,
            Department = model.Department,
            CompanyRole = model.CompanyRole
        };

        var result = await UserManager.CreateAsync(user, model.Password);

        if (!result.Succeeded)
        {
            errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        // по умолчанию всем даём роль "User"
        await UserManager.AddToRoleAsync(user, "User");

        await SignInManager.SignInAsync(user, isPersistent: false);
        Nav.NavigateTo("/");
    }

    public class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string CompanyRole { get; set; } = string.Empty;
    }
}
