@page "/register"
@rendermode InteractiveServer

@using Corporate.Data
@using Corporate.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject CorporateDbContext Db
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav

<h3>Регистрация</h3>

<EditForm Model="@model" OnValidSubmit="RegisterAsync" FormName="RegisterForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Пароль</label>
        <InputText class="form-control" type="password" @bind-Value="model.Password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Подтверждение пароля</label>
        <InputText class="form-control" type="password" @bind-Value="model.ConfirmPassword" />
    </div>

    <div class="mb-3">
        <label class="form-label">ФИО</label>
        <InputText class="form-control" @bind-Value="model.FullName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Отдел</label>
        <select class="form-select" @bind="model.DepartmentId">
            <option value="0">-- выберите отдел --</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>

        <!-- Диагностика (временно) -->
        <div class="text-muted mt-2">DeptId выбран: @model.DepartmentId</div>
        <ul class="text-muted">
            @foreach (var d in departments)
            {
                <li>@d.Id - @d.Name</li>
            }
        </ul>
    </div>

    <div class="mb-3">
        <label class="form-label">Должность</label>
        <select class="form-select" @bind="model.Position">
            <option value="">-- выберите должность --</option>
            @foreach (var p in positions)
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private RegisterModel model = new();
    private string? error;

    private List<Department> departments = new();

    // Второе поле выбора — список должностей
    private readonly string[] positions = new[]
    {
"Сотрудник",
"Организатор мероприятий",
"Руководитель отдела"
};

    protected override async Task OnInitializedAsync()
    {
        departments = await Db.Departments.OrderBy(d => d.Name).ToListAsync();
    }

    private async Task RegisterAsync()
    {
        error = null;

        if (model.Password != model.ConfirmPassword)
        {
            error = "Пароль и подтверждение не совпадают.";
            return;
        }

        if (model.DepartmentId == 0)
        {
            error = "Выберите отдел.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Position))
        {
            error = "Выберите должность.";
            return;
        }

        var deptExists = await Db.Departments.AnyAsync(d => d.Id == model.DepartmentId);
        if (!deptExists)
        {
            error = $"Выбранный отдел не найден (DepartmentId={model.DepartmentId}).";
            return;
        }

        var user = new AppUser
        {
            UserName = model.Email,
            Email = model.Email,
            FullName = model.FullName,
            DepartmentId = model.DepartmentId,
            Position = model.Position
        };

        var result = await UserManager.CreateAsync(user, model.Password);

        if (!result.Succeeded)
        {
            error = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, "Employee");
        if (!roleResult.Succeeded)
        {
            error = string.Join("; ", roleResult.Errors.Select(e => e.Description));
            return;
        }

        Nav.NavigateTo("/login", forceLoad: true);
    }

    private class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;

        public int DepartmentId { get; set; }
        public string Position { get; set; } = string.Empty;
    }
}