@page "/employees"
@rendermode InteractiveServer


@using Corporate.Data
@using Corporate.Models
@using Microsoft.EntityFrameworkCore
@inject CorporateDbContext Db

<h3>Сотрудники</h3>

<div class="row mb-4">
    <div class="col-md-7">
        <EditForm Model="@currentEmployee" OnValidSubmit="@SaveEmployee" FormName="EmployeeForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">ФИО</label>
                <InputText class="form-control" @bind-Value="currentEmployee.FullName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Должность</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Position" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Телефон</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Phone" />
            </div>

            <div class="mb-3">
                <label class="form-label">Подразделение</label>
                <select class="form-select" @bind="currentEmployee.DepartmentId">
                    <option value="">-- не выбрано --</option>
                    @foreach (var dep in departments)
                    {
                        <option value="@dep.Id">@dep.Name</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary me-2">Сохранить</button>
            <button type="button" class="btn btn-secondary" @onclick="ResetForm">Отмена</button>
        </EditForm>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Должность</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Подразделение</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in employees)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.Position</td>
                <td>@e.Email</td>
                <td>@e.Phone</td>
                <td>@e.Department?.Name</td>
                <td>
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => EditEmployee(e.Id)">Ред.</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteEmployee(e.Id)">Удалить</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Employee> employees = new();
    private List<Department> departments = new();
    private Employee currentEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        departments = await Db.Departments
            .OrderBy(d => d.Name)
            .ToListAsync();

        employees = await Db.Employees
            .Include(e => e.Department)
            .OrderBy(e => e.FullName)
            .ToListAsync();
    }

    private async Task SaveEmployee()
    {
        if (currentEmployee.Id == 0)
        {
            Db.Employees.Add(currentEmployee);
        }
        else
        {
            Db.Employees.Update(currentEmployee);
        }

        await Db.SaveChangesAsync();
        await LoadData();
        ResetForm();
    }

    private async Task EditEmployee(int id)
    {
        var e = await Db.Employees.FindAsync(id);
        if (e is not null)
        {
            currentEmployee = new Employee
            {
                Id = e.Id,
                FullName = e.FullName,
                Position = e.Position,
                Email = e.Email,
                Phone = e.Phone,
                DepartmentId = e.DepartmentId
            };
        }
    }

    private async Task DeleteEmployee(int id)
    {
        var e = await Db.Employees.FindAsync(id);
        if (e is not null)
        {
            Db.Employees.Remove(e);
            await Db.SaveChangesAsync();
            await LoadData();
        }
    }

    private void ResetForm()
    {
        currentEmployee = new Employee();
    }
}
