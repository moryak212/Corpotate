@page "/employees"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer


@using Corporate.Data
@using Corporate.Models
@using Microsoft.EntityFrameworkCore
@using Corporate.Services
@inject CorporateDbContext Db
@inject AuditService AuditService
<h3>Сотрудники</h3>

<div class="row mb-4">
    <div class="col-md-7">
        <EditForm Model="@currentEmployee" OnValidSubmit="@SaveEmployee" FormName="EmployeeForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">ФИО</label>
                <InputText class="form-control" @bind-Value="currentEmployee.FullName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Должность</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Position" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Телефон</label>
                <InputText class="form-control" @bind-Value="currentEmployee.Phone" />
            </div>

            <div class="mb-3">
                <label class="form-label">Подразделение</label>
                <select class="form-select" @bind="currentEmployee.DepartmentId">
                    <option value="">-- не выбрано --</option>
                    @foreach (var dep in departments)
                    {
                        <option value="@dep.Id">@dep.Name</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary me-2">Сохранить</button>
            <button type="button" class="btn btn-secondary" @onclick="ResetForm">Отмена</button>
        </EditForm>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Должность</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Подразделение</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in employees)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.Position</td>
                <td>@e.Email</td>
                <td>@e.Phone</td>
                <td>@e.Department?.Name</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary me-1"
                        @onclick="() => EditEmployee(e.Id)">Ред.</button>
                    <button type="button" class="btn btn-sm btn-danger"
                        @onclick="() => DeleteEmployee(e.Id)">Удалить</button>

                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Employee> employees = new();
    private List<Department> departments = new();
    private Employee currentEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        departments = await Db.Departments
        .AsNoTracking()
        .OrderBy(d => d.Name)
        .ToListAsync();

        employees = await Db.Employees
        .AsNoTracking()
        .Include(e => e.Department)
        .OrderBy(e => e.FullName)
        .ToListAsync();
    }


    private async Task SaveEmployee()
    {

        if (string.IsNullOrWhiteSpace(currentEmployee.FullName))
            return;

        var action = currentEmployee.Id == 0 ? "Create" : "Update";

        if (currentEmployee.Id == 0)
        {
            Db.Employees.Add(currentEmployee);
            await Db.SaveChangesAsync();

            await AuditService.LogAsync(action, "Employee", currentEmployee.Id);
        }
        else
        {
            var entity = await Db.Employees.FindAsync(currentEmployee.Id);
            if (entity is null)
                return;


            entity.FullName = currentEmployee.FullName;
            entity.Position = currentEmployee.Position;
            entity.Email = currentEmployee.Email;
            entity.Phone = currentEmployee.Phone;
            entity.DepartmentId = currentEmployee.DepartmentId;

            await Db.SaveChangesAsync();

            await AuditService.LogAsync(action, "Employee", entity.Id);
        }

        await LoadData();
        ResetForm();
    }


    private async Task EditEmployee(int id)
    {
        var e = await Db.Employees
        .AsNoTracking()
        .FirstOrDefaultAsync(x => x.Id == id);

        if (e is not null)
        {
            currentEmployee = new Employee
            {
                Id = e.Id,
                FullName = e.FullName,
                Position = e.Position,
                Email = e.Email,
                Phone = e.Phone,
                DepartmentId = e.DepartmentId
            };
        }
    }


    private async Task DeleteEmployee(int id)
    {
        var e = await Db.Employees.FindAsync(id);
        if (e is null)
            return;

        Db.Employees.Remove(e);
        await Db.SaveChangesAsync();

        await AuditService.LogAsync("Delete", "Employee", id);

        await LoadData();
    }



    private void ResetForm()
    {
        currentEmployee = new Employee();
    }
}